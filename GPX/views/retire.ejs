<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/withdraw.css">
</head>

<body>

    <%- include('partials/header') %>

    <div class="container deposit-container">
        <h2 style="margin-bottom: 30px;">Retirar EUR</h2>

        <!-- Selector de moneda -->
        <div class="currency-selector">
            <div style="display: flex; gap: 10px; align-items: center;">
                <span
                    style="background: #0055ff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    €
                </span>
                EUR Euro
            </div>
            <span>⌄</span>
        </div>

        <!-- Cantidad -->
        <div class="section-label">Cantidad a retirar</div>
        <div class="form-group">
            <input 
                type="number" 
                name="amount" 
                placeholder="Ej: 100.00 EUR" 
                min="10"
                step="0.01"
                required
            >
            <small style="color:#888;">Mínimo de retirada: 10 EUR</small>
        </div>

        <!-- Método de retirada -->
        <div class="section-label">Método de retirada</div>

        <div class="payment-methods">
            <div class="method-card" style="border-color: var(--primary-color);">
                <div class="method-header">
                    <div class="method-icon" style="background: #0088cc;"></div>
                    <div>
                        <div class="method-title">Transferencia bancaria (SEPA)</div>
                        <div style="font-size: 12px; color: #888;">
                            Recibe tu dinero en tu cuenta bancaria
                        </div>
                    </div>
                </div>
                <div class="tags">
                    <span class="tag">1 EUR de comisión</span>
                    <span class="tag">1–3 días laborables</span>
                </div>
            </div>
        </div>

        <!-- Información -->
        <div class="section-label">Información importante</div>
        <ul style="color:#888; font-size:14px; margin-bottom:30px;">
            <li>Las retiradas se procesan en días laborables</li>
            <li>La cuenta bancaria debe estar a tu nombre</li>
            <li>Podrían aplicarse verificaciones de seguridad</li>
        </ul>

        <button class="btn btn-primary" style="width: 100%; padding: 15px;">
            Solicitar retirada
        </button>
    </div>

    <%- include('partials/footer') %>

</body>

</html>